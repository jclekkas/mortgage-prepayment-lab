{
  "name": "mortgage-prepayment-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Educational simulator for mortgage prepayment and servicing portfolio economics. Synthetic data only.",
  "license": "UNLICENSED",
  "author": "Chris Lekkas",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:numerics": "vitest run tests/numerics",
    "test:e2e": "playwright test",
    "bench": "vitest run tests/perf",
    "licenses": "node scripts/licenses.mjs",
    "reference": "python3 -I scripts/reference_model.py"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
